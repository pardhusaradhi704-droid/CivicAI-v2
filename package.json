{
  "name": "civic-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "files": [
    "src",
    "server.ts",
    "schema.sql",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "metadata.json",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    ".env.example",
    "assets"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "export:zip": "zip -r civic-ai-complete-source.zip src server.ts schema.sql index.html vite.config.ts tsconfig.json metadata.json Dockerfile docker-compose.yml README.md .env.example assets package.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
     "vite": "^6.2.3"
  }
}
